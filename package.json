{
  "name": "dsh-screenshot-plugin",
  "version": "1.1.0",
  "private": true,
  "description": "Screenshot plugin for DeepSeek Harness: agent tool plus a one-click composer button on Windows.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "screenshot",
    "capture",
    "windows",
    "plugin"
  ],
  "author": "yangmou2004",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangmou2004/dsh-screenshot.git"
  },
  "homepage": "https://github.com/yangmou2004/dsh-screenshot#readme",
  "bugs": {
    "url": "https://github.com/yangmou2004/dsh-screenshot/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "capture.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
